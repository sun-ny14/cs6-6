{
  "rules": {
    ".read": "auth != null && auth.token.email_verified == true && auth.token.firebase.sign_in_provider == 'google.com' && auth.token.email == 'ksosuny@cberi.go.kr'",
    ".write": "auth != null && auth.token.email_verified == true && auth.token.firebase.sign_in_provider == 'google.com' && auth.token.email == 'ksosuny@cberi.go.kr'",
    "userEmails": { "$email": { ".read": "auth != null && auth.token.email_verified == true && auth.token.firebase.sign_in_provider == 'google.com' && $email == auth.token.email.replace('.', ',')" } },
    "users": { "$userName": { ".read": "auth != null && auth.token.email_verified == true && auth.token.firebase.sign_in_provider == 'google.com' && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName && data.child('email').val() == auth.token.email" } },
    "publicStudents": { ".read": "auth != null && auth.token.email_verified == true && auth.token.firebase.sign_in_provider == 'google.com' && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
    "rooms": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.firebase.sign_in_provider == 'google.com' && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()",
      "$userName": { "objects": { "$object": {
        ".write": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName && data.exists() && !newData.exists()",
        "x": { ".write": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName && data.parent().exists()", ".validate": "newData.isNumber() && newData.val() >= -2000 && newData.val() <= 4000" },
        "y": { ".write": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName && data.parent().exists()", ".validate": "newData.isNumber() && newData.val() >= -2000 && newData.val() <= 4000" },
        "w": { ".write": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName && data.parent().exists()", ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4000" },
        "h": { ".write": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName && data.parent().exists()", ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4000" },
        "flipX": { ".write": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName && data.parent().exists()", ".validate": "newData.isBoolean()" },
        "flipped": { ".write": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName && data.parent().exists()", ".validate": "newData.isBoolean()" }
      } } }
    },
    "settings": {
      "lateTime": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
      "closeTime": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
      "routineText": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
      "giftList": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
      "defaultBg": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
      "housingEnabled": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
      "studentRoles": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
      "cleaningAssignments": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" }
    },
    "shop": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
    "housingShop": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
    "pointGuide": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
    "seatLayoutData": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
    "orders": {
      ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString() && (root.child('users').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).child('role').val() == '상점' || root.child('users').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).child('isHelper').val() == true || root.child('settings/studentRoles').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).val() == '상점' || (query.orderByChild == 'user' && query.equalTo == root.child('userEmails').child(auth.token.email.replace('.', ',')).val()))",
      ".indexOn": ["user"],
      "$order": { ".read": "auth != null && data.child('user').val() == root.child('userEmails').child(auth.token.email.replace('.', ',')).val()" }
    },
    "pointLogs": { ".read": "auth != null && query.orderByChild == 'name' && query.equalTo == root.child('userEmails').child(auth.token.email.replace('.', ',')).val()", ".indexOn": ["name"] },
    "pointHistory": { "$userName": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).val() == $userName" } },
    "classManagement": { "cleaningStatus": {
      ".read": "auth != null && (root.child('users').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).child('role').val() == '청소' || root.child('settings/cleaningAssignments').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).val() == true || root.child('settings/cleaningAssignments').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).child('enabled').val() == true)",
      ".write": "auth != null && (root.child('users').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).child('role').val() == '청소' || root.child('settings/cleaningAssignments').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).val() == true || root.child('settings/cleaningAssignments').child(root.child('userEmails').child(auth.token.email.replace('.', ',')).val()).child('enabled').val() == true)"
    } },
    "blackboard": {
      "assignments": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" },
      "assignmentCompletions": { ".read": "auth != null && root.child('userEmails').child(auth.token.email.replace('.', ',')).isString()" }
    },
    "blackboardDisplay": { ".read": true }
  }
}
